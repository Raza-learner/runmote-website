---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a class="nav-brand" href="#">
        <img src="/logo.png" alt="Runmote" width="28" height="28" />
        <span>Runmote</span>
      </a>
      <nav class="nav-links">
        <a href="#why">Why</a>
        <a href="#how">How</a>
        <a href="#agents">Agents</a>
        <a href="#faq">FAQ</a>
        <a href="https://github.com/Raza-learner/Runmote" target="_blank" rel="noreferrer">GitHub</a>
        <a class="nav-cta" href="#install">Get started</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="section" style="padding-top: var(--space-2xl)">
    <div class="container hero">
      <div class="hero-copy">
        <div class="eyebrow reveal">Mobile → PC · QR or 8-digit · No SSH</div>
        <h1 class="reveal" data-delay="60" style="margin-top: var(--space-s)">
          Code from<br/>your phone.
        </h1>
        <p class="lead reveal" data-delay="110" style="margin-top: var(--space-m)">
          Run any ACP agent on your PC — <strong style="font-weight:600; color: var(--ink)">opencode, Claude Code, Codex, Cursor</strong> — from iOS or Android. Start a session on the bus, resume it from bed. One command. Any network.
        </p>

        <div class="reveal" data-delay="140" style="margin-top: var(--space-m)">
          <div class="chips">
            <span class="chip">opencode</span>
            <span class="chip">claude</span>
            <span class="chip">codex</span>
            <span class="chip">cursor</span>
            <span class="chip">copilot</span>
            <span class="chip">gemini</span>
          </div>
        </div>

        <div class="reveal" data-delay="160" style="margin-top: var(--space-l)">
          <div class="os-switch" role="tablist" aria-label="Choose your OS">
            <button class="os-tab" role="tab" aria-selected="true" data-target="panel-unix" id="tab-unix" aria-controls="panel-unix">Linux / macOS</button>
            <button class="os-tab" role="tab" aria-selected="false" data-target="panel-win" id="tab-win" aria-controls="panel-win" tabindex="-1">Windows</button>
          </div>
          <div class="os-panel" id="panel-unix" role="tabpanel" aria-labelledby="tab-unix">
            <span id="install" class="code-pill"><span style="opacity:.55">$</span> curl -fsSL https://runmote.dev/install.sh | bash <button class="copy" data-copy="curl -fsSL https://runmote.dev/install.sh | bash">Copy</button></span>
          </div>
          <div class="os-panel" id="panel-win" role="tabpanel" aria-labelledby="tab-win" hidden>
            <a class="btn btn-primary" href="https://github.com/Raza-learner/Runmote/releases/download/v0.1.0/Runmote_0.1.0_x64-setup.exe" rel="noreferrer">Download Windows app (.exe)</a>
          </div>
        </div>

        <div class="reveal" data-delay="200" style="margin-top: var(--space-l); display:flex; gap: var(--space-m); flex-wrap:wrap; align-items:center">
          <a class="btn btn-primary" href="https://play.google.com/store/apps/details?id=dev.runmote.app" target="_blank" rel="noreferrer">Get the app on Google Play</a>
        </div>
      </div>

      <div class="hero-phone reveal" data-delay="130">
        <div class="phone" id="phone">
          <img src="/phone.png" alt="Runmote app" width="540" height="1170" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- WHY — comparison table -->
  <section id="why" class="section">
    <div class="container">
      <div class="eyebrow reveal">Why Runmote</div>
      <h2 class="reveal" data-delay="60" style="margin-top: var(--space-s)">SSH is powerful. It's also work.</h2>
      <p class="sec-intro reveal" data-delay="90" style="margin-top: var(--space-m)">You could SSH tunnel into your PC — if you like typing firewall rules at 11pm. Runmote connects out over ordinary internet. No SSH. No VPN. No port forwarding.</p>
      <div class="reveal" data-delay="110" style="margin-top: var(--space-l)">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">SSH</th>
              <th scope="col">Runmote</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="row-head">Setup time</td>
              <td class="lose">30 minutes of iptables hell</td>
              <td class="win">One curl command</td>
            </tr>
            <tr>
              <td class="row-head">Port forwarding</td>
              <td class="lose">Yes, on every network</td>
              <td class="win">Never</td>
            </tr>
            <tr>
              <td class="row-head">Works on 4G</td>
              <td class="lose">Only if you port-forwarded</td>
              <td class="win">Yes — it's just the internet</td>
            </tr>
            <tr>
              <td class="row-head">Mobile app</td>
              <td class="lose">Termius + tmux + prayer</td>
              <td class="win">Native Flutter app</td>
            </tr>
            <tr>
              <td class="row-head">Session persistence</td>
              <td class="lose">tmux resurrection scripts</td>
              <td class="win">Built-in, automatic</td>
            </tr>
            <tr>
              <td class="row-head">Keep your sessions</td>
              <td class="lose">Hope screen didn't die</td>
              <td class="win">Resumes from last message</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- HOW — numbered steps -->
  <section id="how" class="section">
    <div class="container">
      <h2 class="reveal">Three steps. Two minutes.</h2>
      <ol class="steps reveal" data-delay="80" style="margin-top: var(--space-l)">
        <li>
          <span class="num">01</span>
          <div>
            <h3>Install the daemon</h3>
            <p>One command, no config files. Runs as a background service on Linux, macOS, or Windows — systemd, launchd, or Task Scheduler.</p>
            <p style="margin-top: var(--space-xs)"><span class="kbd">curl -fsSL https://runmote.dev/install.sh | bash</span></p>
          </div>
        </li>
        <li>
          <span class="num">02</span>
          <div>
            <h3>Pair — QR or 8-digit</h3>
            <p><span class="kbd">runmote start</span> shows a QR code and an 8-digit code in your terminal. Scan it or type it in the app. Fresh code every restart.</p>
          </div>
        </li>
        <li>
          <span class="num">03</span>
          <div>
            <h3>Code from anywhere</h3>
            <p>Open the app, pick an agent, go. Streaming tool calls, diffs, and approvals over the same ACP session — home, office, 4G, hotel WiFi.</p>
          </div>
        </li>
      </ol>

      <div class="reveal" data-delay="100" style="margin-top: var(--space-l)">
        <h3 style="font-family: var(--font-display); font-size: var(--step-2); margin-bottom: var(--space-s)">After install</h3>
        <ul class="cmds">
          <li><code>runmote start</code><span class="c-desc">Start the daemon, show the pairing QR</span></li>
          <li><code>runmote code</code><span class="c-desc">Re-display the pairing code anytime</span></li>
          <li><code>runmote text</code><span class="c-desc">Show the code as text (XXXX-XXXX)</span></li>
          <li><code>runmote status</code><span class="c-desc">Is the daemon running?</span></li>
          <li><code>runmote stop</code><span class="c-desc">Stop the daemon</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <h2 class="reveal">Everything you need. Nothing you don't.</h2>
      <ul class="features reveal" data-delay="80" style="margin-top: var(--space-l)">
        <li>
          <div>
            <div class="f-title">Streaming responses</div>
            <div class="f-desc">Live agent output, tool calls, thinking, terminal, diffs — JSON-RPC 2.0, no polling.</div>
          </div>
        </li>
        <li>
          <div>
            <div class="f-title">Live diffs &amp; approvals</div>
            <div class="f-desc">See before/after file changes and accept or deny permission requests from your phone.</div>
          </div>
        </li>
        <li>
          <div>
            <div class="f-title">Sessions that resume</div>
            <div class="f-desc">Switch apps, lose WiFi, kill the app — pick up right where you left off.</div>
          </div>
        </li>
        <li>
          <div>
            <div class="f-title">Self-hostable relay</div>
            <div class="f-desc"><span class="kbd">docker compose up -d</span> → set <span class="kbd">ACP_RELAY_URL</span>. Full control, one container.</div>
          </div>
        </li>
        <li>
          <div>
            <div class="f-title">MCP servers from the app</div>
            <div class="f-desc">Add stdio or HTTP MCP servers with name, command, and args — no editing config files on the PC.</div>
          </div>
        </li>
        <li>
          <div>
            <div class="f-title">Filesystem access</div>
            <div class="f-desc">Browse directories and read or edit text files on your PC, right from the phone.</div>
          </div>
        </li>
        <li>
          <div>
            <div class="f-title">Any agent that speaks ACP</div>
            <div class="f-desc">OpenCode, Claude Code, Codex, Cursor, Copilot, Gemini CLI — auto-detected on install.</div>
          </div>
        </li>
        <li>
          <div>
            <div class="f-title">Native everywhere</div>
            <div class="f-desc">Flutter iOS/Android on the phone, a Windows desktop app, and a Linux/macOS/Windows daemon.</div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- AGENTS — supported agent matrix -->
  <section id="agents" class="section">
    <div class="container">
      <div class="eyebrow reveal">Supported agents</div>
      <h2 class="reveal" data-delay="60" style="margin-top: var(--space-s)">Auto-detects what you already have.</h2>
      <p class="sec-intro reveal" data-delay="90" style="margin-top: var(--space-m)">The daemon scans your PATH and known install dirs, then wires each agent's ACP adapter. Install a new agent — it shows up in the app without a restart. Any agent that speaks <a href="https://agentclientprotocol.com" target="_blank" rel="noreferrer" style="color: var(--ink); text-decoration: underline; text-underline-offset: 2px">ACP</a> works.</p>
      <div class="reveal" data-delay="110" style="margin-top: var(--space-l)">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col">Agent</th>
              <th scope="col">Linux</th>
              <th scope="col">macOS</th>
              <th scope="col">Windows</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="row-head">OpenCode</td><td class="win">Auto</td><td class="win">Auto</td><td class="lose">Manual</td></tr>
            <tr><td class="row-head">Cursor</td><td class="win">Auto</td><td class="win">Auto</td><td class="win">Auto</td></tr>
            <tr><td class="row-head">Claude Code</td><td class="win">Auto</td><td class="win">Auto</td><td class="win">Auto</td></tr>
            <tr><td class="row-head">Codex</td><td class="win">Auto</td><td class="win">Auto</td><td class="win">Auto</td></tr>
            <tr><td class="row-head">GitHub Copilot</td><td class="win">Auto</td><td class="win">Auto</td><td class="lose">Manual</td></tr>
            <tr><td class="row-head">Gemini CLI</td><td class="lose">Manual</td><td class="lose">—</td><td class="lose">—</td></tr>
          </tbody>
        </table>
        <p style="margin-top: var(--space-s); color: var(--ink-3); font-size: var(--step--1)">Not auto-detected? Set <span class="kbd">ACP_AGENT_COMMANDS</span> to a JSON array of agent configs.</p>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section id="stats" class="stats-band">
    <div class="container">
      <div class="stat-grid">
        <div class="stat"><div id="stat-stars" class="stat-num" data-value="0">0</div><div class="stat-label">GitHub stars</div></div>
        <div class="stat"><div id="stat-forks" class="stat-num" data-value="0">0</div><div class="stat-label">Forks</div></div>
        <div class="stat"><div id="stat-releases" class="stat-num" data-value="0">0</div><div class="stat-label">Releases</div></div>
        <div class="stat"><div class="stat-num" style="color: var(--accent)">WSS</div><div class="stat-label">End-to-end</div></div>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE — scroll-drawn pipeline -->
  <section class="section">
    <div class="container">
      <div class="eyebrow reveal">Architecture</div>
      <h2 class="reveal" data-delay="60" style="margin-top: var(--space-s)">No hacks. Just WSS.</h2>
      <p class="sec-intro reveal" data-delay="100" style="margin-top: var(--space-m)">Two WebSocket hops, both encrypted. App → Relay → Daemon → ACP agent via stdin/stdout. The session lives on your machine — the relay only passes traffic and remembers your session list.</p>
      <div class="reveal" data-delay="140" style="margin-top: var(--space-l)">
        <svg class="pipeline" id="pipeline" viewBox="0 0 720 140" width="100%" height="auto" style="display:block">
          <g>
            <line id="link-1" class="link" x1="118" y1="62" x2="224" y2="62" />
            <line id="link-2" class="link" x1="396" y1="62" x2="502" y2="62" />
            <line id="link-3" class="link" x1="574" y1="62" x2="680" y2="62" />

            <rect class="node" x="16" y="26" width="102" height="72" />
            <text class="node-label" x="67" y="57" text-anchor="middle">App</text>
            <text class="node-sub" x="67" y="73" text-anchor="middle">Flutter</text>

            <rect class="node" x="224" y="26" width="172" height="72" />
            <text class="node-label" x="310" y="57" text-anchor="middle">Relay</text>
            <text class="node-sub" x="310" y="73" text-anchor="middle">FastAPI · WSS</text>

            <rect class="node" x="396" y="26" width="178" height="72" />
            <text class="node-label" x="485" y="57" text-anchor="middle">Daemon</text>
            <text class="node-sub" x="485" y="73" text-anchor="middle">Python</text>

            <rect class="node" x="574" y="26" width="130" height="72" />
            <text class="node-label" x="639" y="57" text-anchor="middle">Agent</text>
            <text class="node-sub" x="639" y="73" text-anchor="middle">opencode / codex</text>
          </g>
        </svg>
      </div>
      <div class="reveal" data-delay="180" style="margin-top: var(--space-s); color: var(--ink-3); font-size: var(--step--1)">WSS/TLS · JSON-RPC 2.0 · SQLite · mDNS (LAN)</div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container">
      <h2 class="reveal">FAQ</h2>
      <div style="margin-top: var(--space-l); max-width: 820px">
        <details class="faq reveal"><summary>Does my PC need to stay on?<span class="plus">+</span></summary><p>Yes — the daemon runs as a background service (systemd / launchd / Task Scheduler) and idles at near-zero usage. It only spawns an agent when a session is active. If the PC is off, the app shows a disconnected banner until you run <span class="kbd">runmote</span>.</p></details>
        <details class="faq reveal" data-delay="40"><summary>Is this secure?<span class="plus">+</span></summary><p>Both connections are WSS (WebSocket over TLS). Pairing codes are rate-limited (5 tries/IP/min), expire after 15 minutes, and rotate on every daemon start. Session content stays on your machine — the relay only passes traffic and stores session metadata.</p></details>
        <details class="faq reveal" data-delay="80"><summary>Can anyone connect?<span class="plus">+</span></summary><p>No — a fresh 8-digit code is generated each time the daemon starts, and only your terminal shows it. The code rotates on restart, and you can force a new one anytime with <span class="kbd">runmote code</span>.</p></details>
        <details class="faq reveal" data-delay="120"><summary>iPhone and Android?<span class="plus">+</span></summary><p>Yes — the app is built with Flutter and shipped natively for both. Android is on <a href="https://play.google.com/store/apps/details?id=dev.runmote.app" target="_blank" rel="noreferrer" style="color: var(--ink); text-decoration: underline; text-underline-offset: 2px">Google Play</a> with APKs in the GitHub releases; iOS is available via TestFlight.</p></details>
        <details class="faq reveal" data-delay="160"><summary>Can I self-host the relay?<span class="plus">+</span></summary><p>Yes — the relay is 100% open source. Run <span class="kbd">docker compose up -d</span>, then set <span class="kbd">ACP_RELAY_URL</span> on the daemon. Pairing QR codes embed your relay's public URL automatically, and there's a LAN-only mode that works without internet via mDNS.</p></details>
        <details class="faq reveal" data-delay="200"><summary>Why does Windows show a SmartScreen warning?<span class="plus">+</span></summary><p>The Windows installer isn't signed by a trusted certificate authority yet, so Windows shows a blue "protected your PC" screen. Click <strong>More info → Run anyway</strong> — the app is open source and fully auditable.</p></details>
      </div>
      <div class="reveal" data-delay="150" style="margin-top: var(--space-xl); display:flex; flex-wrap:wrap; gap: var(--space-l); align-items:center; justify-content:space-between">
        <div>
          <h3 style="font-family: var(--font-display); font-size: var(--step-2)">Ready to try?</h3>
          <p style="margin: var(--space-3xs) 0 0; color: var(--ink-2)">One command. Thirty seconds.</p>
        </div>
        <div style="display:flex; gap: var(--space-s); flex-wrap:wrap"><a class="btn btn-primary" href="#install">Install daemon</a><a class="btn btn-ghost" href="https://play.google.com/store/apps/details?id=dev.runmote.app" target="_blank" rel="noreferrer">Get the app</a><a class="btn btn-ghost" href="https://github.com/Raza-learner/Runmote">GitHub</a></div>
      </div>
    </div>
  </section>

  <footer class="section footer">
    <div class="container" style="display:flex; flex-wrap:wrap; gap: var(--space-s); justify-content:space-between">
      <span>MIT © Raza — <a href="https://github.com/Raza-learner/Runmote">Runmote</a> · ACP</span>
      <span><a href="https://ko-fi.com/razalearner">Ko-fi</a> · <a href="https://github.com/sponsors/Raza-learner">Sponsor</a></span>
    </div>
  </footer>

  <script>
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        const t = (b as HTMLElement).dataset.copy!;
        await navigator.clipboard.writeText(t);
        const o = (b as HTMLElement).textContent;
        (b as HTMLElement).textContent = 'Copied!';
        setTimeout(() => ((b as HTMLElement).textContent = o), 1100);
      });
    });

    document.querySelectorAll('.os-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll<HTMLElement>('.os-tab').forEach((t) => {
          t.setAttribute('aria-selected', String(t === tab));
          t.tabIndex = t === tab ? 0 : -1;
        });
        const target = tab.dataset.target!;
        document.querySelectorAll<HTMLElement>('.os-panel').forEach((p) => {
          p.hidden = p.id !== target;
          p.setAttribute('aria-hidden', String(p.id !== target));
        });
      });
    });
  </script>
</Layout>
