  <script>
    // copy button
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        const t = (b as HTMLElement).dataset.copy!;
        await navigator.clipboard.writeText(t);
        const orig = (b as HTMLElement).textContent;
        (b as HTMLElement).textContent = 'Copied!';
        setTimeout(() => ((b as HTMLElement).textContent = orig), 1200);
      });
    });
    // smooth anchor with Lenis
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = (a as HTMLAnchorElement).getAttribute('href')!;
        if (id.length > 1) {
          const el = document.querySelector(id);
          if (el) { e.preventDefault(); el.scrollIntoView({ behavior: 'smooth', block: 'start' }); history.replaceState(null, '', id); }
        }
      });
    });
  </script>
