---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="#" style="display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-0.03em">
        <span style="width:28px;height:28px;border-radius:8px;background:var(--text);color:#FFFBF0;display:grid;place-items:center;font-size:13px">◐</span>
        Runmote
        <span style="font-weight:600;color:var(--muted);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;border:1px solid var(--border);padding:3px 8px;border-radius:999px;background:var(--surface)">ACP • Open Source</span>
      </a>
      <nav class="nav-links">
        <a href="#how">How it works</a>
        <a href="#faq">FAQ</a>
        <a href="https://github.com/Raza-learner/Runmote" target="_blank" rel="noreferrer">GitHub</a>
        <a class="btn btn-primary" style="padding:9px 14px;font-size:13px" href="#install">Get started</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="section" style="padding-top:36px">
    <div class="container" style="display:grid;grid-template-columns:1.05fr 0.95fr;gap:40px;align-items:center">
      <div>
        <div class="eyebrow reveal">Mobile → PC • QR or 8-digit • No SSH</div>
        <h1 class="reveal" data-delay="60" style="margin-top:14px">
          Code from<br/>
          <span style="color:var(--accent)">your phone.</span>
        </h1>
        <p class="lead reveal" data-delay="120" style="margin-top:12px">
          Run any ACP agent on your PC — <b style="color:var(--text)">opencode, Claude Code, Codex, Cursor</b> — from iOS or Android. One command to install. Works on any network.
        </p>

        <div class="reveal" data-delay="160" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:20px">
          <a class="btn btn-primary" href="#install">Install daemon — curl | bash</a>
          <a class="btn btn-ghost" href="https://play.google.com/store/apps/details?id=dev.runmote.app" target="_blank" rel="noreferrer">Google Play</a>
        </div>

        <div class="reveal" data-delay="200" style="margin-top:16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
          <span id="install" class="code-pill"><span style="opacity:.6">$</span> curl -fsSL https://runmote.dev/install.sh | bash <button data-copy="curl -fsSL https://runmote.dev/install.sh | bash" style="margin-left:4px;background:#222;color:#FFFBF0;border:1px solid #333;padding:6px 8px;border-radius:8px;cursor:pointer;font-size:11px">Copy</button></span>
        </div>
        <div class="reveal" data-delay="240" style="margin-top:8px;color:var(--faint);font-size:12px">Windows: <span class="kbd">irm https://runmote.dev/install.ps1 | iex</span> • Self-hostable relay</div>

        <div class="reveal" data-delay="280" style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
          <span style="font-size:12px;color:var(--muted)">Supported:</span>
          <span style="font-size:12px;font-weight:700">opencode</span><span style="color:var(--border)">•</span>
          <span style="font-size:12px;font-weight:700">claude</span><span style="color:var(--border)">•</span>
          <span style="font-size:12px;font-weight:700">codex</span><span style="color:var(--border)">•</span>
          <span style="font-size:12px;font-weight:700">cursor</span><span style="color:var(--border)">•</span>
          <span style="font-size:12px;font-weight:700">copilot</span>
        </div>
      </div>

      <div class="reveal" data-delay="140" style="display:grid;place-items:center">
        <div class="phone">
          <div class="phone-screen">
            <div class="phone-notch"></div>
            <div style="padding:14px 14px 0;display:flex;align-items:center;justify-content:space-between">
              <span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#9A94A6;font-weight:700">Runmote</span>
              <span style="width:8px;height:8px;border-radius:999px;background:#0EA5E9"></span>
            </div>
            <div style="margin:12px 12px 0;padding:14px;border-radius:14px;border:1px solid #E9DDC4;background:#FFFBF0">
              <div style="font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#9A94A6;font-weight:700">Pairing code</div>
              <div style="font-family:JetBrains Mono,monospace;font-size:22px;letter-spacing:0.16em;font-weight:800;margin-top:4px">84 92 17 05</div>
              <div style="font-size:11px;color:#6B6575;margin-top:2px">Scan QR or type code — rotates on restart</div>
            </div>
            <div style="margin:10px 12px;display:grid;gap:8px">
              <div style="display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:12px;background:white;border:1px solid #E9DDC4"><span style="width:28px;height:28px;border-radius:8px;background:#111;display:grid;place-items:center;color:white;font-size:12px">›</span><div><div style="font-weight:700;font-size:13px">opencode</div><div style="font-size:11px;color:#6B6575">auto-detected</div></div><span style="margin-left:auto;width:7px;height:7px;border-radius:999px;background:#16A34A"></span></div>
              <div style="display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:12px;background:white;border:1px solid #E9DDC4"><span style="width:28px;height:28px;border-radius:8px;background:white;border:1px solid #E9DDC4;display:grid;place-items:center;font-size:12px">✦</span><div><div style="font-weight:700;font-size:13px">claude</div><div style="font-size:11px;color:#6B6575">claude-agent-acp</div></div><span style="margin-left:auto;width:7px;height:7px;border-radius:999px;background:#16A34A"></span></div>
              <div style="display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:12px;background:white;border:1px solid #E9DDC4"><span style="width:28px;height:28px;border-radius:8px;background:white;border:1px solid #E9DDC4;display:grid;place-items:center;font-size:12px">⬡</span><div><div style="font-weight:700;font-size:13px">codex</div><div style="font-size:11px;color:#6B6575">codex-acp</div></div><span style="margin-left:auto;width:7px;height:7px;border-radius:999px;background:#16A34A"></span></div>
            </div>
            <div style="margin-top:auto;padding:10px 12px;display:flex;gap:8px">
              <span style="flex:1;padding:11px;border-radius:999px;background:#111;color:white;text-align:center;font-weight:700;font-size:13px">Connect</span>
              <span style="padding:11px 14px;border-radius:999px;background:white;border:1px solid #E9DDC4;font-weight:700;font-size:13px">Scan QR</span>
            </div>
          </div>
        </div>
        <div style="margin-top:14px;display:flex;gap:8px;align-items:center;color:var(--faint);font-size:11px">
          <span style="width:6px;height:6px;border-radius:999px;background:var(--accent)"></span> Live session • WSS encrypted
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- WHY — minimal single comparison -->
  <section class="section">
    <div class="container">
      <div class="eyebrow reveal">Why Runmote</div>
      <h2 class="reveal" data-delay="60" style="margin-top:10px">SSH is powerful. It’s also work.</h2>
      <div class="grid reveal" data-delay="120" style="grid-template-columns:repeat(3,1fr);margin-top:18px">
        <div class="card"><div style="width:32px;height:32px;border-radius:8px;background:var(--text);color:white;display:grid;place-items:center;font-size:14px">◷</div><h3 style="margin-top:12px">30 min → 30 sec</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">No firewall rules, no port forwarding. One curl command.</p></div>
        <div class="card"><div style="width:32px;height:32px;border-radius:8px;background:var(--accent);color:white;display:grid;place-items:center;font-size:14px">◎</div><h3 style="margin-top:12px">Any network</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Home, office, 4G, hotel WiFi — WSS only.</p></div>
        <div class="card"><div style="width:32px;height:32px;border-radius:8px;background:var(--accent-2);color:white;display:grid;place-items:center;font-size:14px">↻</div><h3 style="margin-top:12px">Sessions resume</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Phone dies, app killed — back to last message.</p></div>
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section id="how" class="section" style="background:var(--surface-2);border-block:1px solid var(--border)">
    <div class="container">
      <h2 class="reveal">Three steps. Two minutes.</h2>
      <div class="grid reveal" data-delay="80" style="grid-template-columns:repeat(3,1fr);margin-top:18px">
        <div class="card"><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--faint);font-weight:700">01 — Install</span><h3 style="margin-top:8px">Daemon on your PC</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 10px">Linux / macOS / Windows. Auto-detects agents.</p><div style="font-family:JetBrains Mono,monospace;font-size:12px;background:#111;color:#FFFBF0;padding:10px 12px;border-radius:10px">curl -fsSL https://runmote.dev/install.sh | bash</div></div>
        <div class="card"><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--faint);font-weight:700">02 — Pair</span><h3 style="margin-top:8px">QR or 8-digit</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Open app, scan or type code from <span class="kbd">runmote code</span>. Rotates on restart.</p></div>
        <div class="card"><span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--faint);font-weight:700">03 — Code</span><h3 style="margin-top:8px">Anywhere</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Streaming chat, tool calls, diffs, approvals — same session.</p></div>
      </div>
    </div>
  </section>

  <!-- FEATURES — trimmed to essentials, no repetition -->
  <section class="section">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:baseline;justify-content:space-between">
        <h2 class="reveal">Everything you need. Nothing you don’t.</h2>
        <span class="reveal" data-delay="60" style="color:var(--faint);font-size:12px">ACP-native • MIT</span>
      </div>
      <div class="grid reveal" data-delay="100" style="grid-template-columns:repeat(3,1fr);margin-top:18px">
        <div class="card"><h3>Streaming</h3><p style="color:var(--muted);font-size:13px">Live agent output, tool calls, diffs — no polling.</p></div>
        <div class="card"><h3>Self-hostable relay</h3><p style="color:var(--muted);font-size:13px"><span class="kbd">docker compose up -d</span> → set <span class="kbd">ACP_RELAY_URL</span>.</p></div>
        <div class="card"><h3>Native apps</h3><p style="color:var(--muted);font-size:13px">Flutter iOS/Android. Daemon on Linux/macOS/Windows.</p></div>
      </div>
    </div>
  </section>

  <!-- STATS — clean minimal, bright accent -->
  <section id="stats" class="section" style="padding-top:0">
    <div class="container">
      <div class="card" style="display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between;background:var(--text);color:#FFFBF0;border-color:#1A1A1A">
        <div style="display:flex;gap:28px;flex-wrap:wrap">
          <div><div id="stat-stars" class="stat-num" data-value="0" style="color:white">0</div><div class="stat-label" style="color:#9A94A6">GitHub stars — live</div></div>
          <div style="width:1px;background:#2A2A2A"></div>
          <div><div id="stat-forks" class="stat-num" data-value="0" style="color:white">0</div><div class="stat-label" style="color:#9A94A6">Forks</div></div>
          <div style="width:1px;background:#2A2A2A"></div>
          <div><div id="stat-releases" class="stat-num" data-value="0" style="color:white">0</div><div class="stat-label" style="color:#9A94A6">Releases</div></div>
          <div style="width:1px;background:#2A2A2A"></div>
          <div><div style="font-size:28px;font-weight:800;letter-spacing:-0.04em">WSS</div><div class="stat-label" style="color:#9A94A6">Encrypted</div></div>
        </div>
        <a href="https://github.com/Raza-learner/Runmote" target="_blank" rel="noreferrer" style="padding:10px 14px;border-radius:999px;background:var(--accent);color:white;font-weight:700;font-size:13px">Star on GitHub →</a>
      </div>
      <div style="margin-top:10px;color:var(--faint);font-size:11px">Numbers animate with CountUp.js — fetched live from <span class="kbd">api.github.com</span>. Powered by anime.js subtle reveals.</div>
    </div>
  </section>

  <!-- ARCH — ultra minimal -->
  <section class="section" style="padding-top:0">
    <div class="container" style="display:grid;grid-template-columns:1fr 1.2fr;gap:24px;align-items:center">
      <div class="reveal">
        <h2>Phone → Relay → Daemon → Agent</h2>
        <p style="color:var(--muted);margin-top:8px;font-size:14px">No hacks. WebSocket everywhere, stdin/stdout to the ACP agent. Session lives on your machine.</p>
        <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><span class="kbd">WSS/TLS</span><span class="kbd">JSON-RPC 2.0</span><span class="kbd">SQLite</span></div>
      </div>
      <div class="card reveal" data-delay="80" style="padding:0;overflow:hidden">
        <svg viewBox="0 0 640 120" width="100%" height="auto" style="display:block">
          <rect x="16" y="24" width="140" height="72" rx="12" fill="white" stroke="#E9DDC4"/><text x="86" y="54" text-anchor="middle" font-size="11" font-weight="800" fill="#111">App</text><text x="86" y="68" text-anchor="middle" font-size="10" fill="#6B6575">Flutter</text>
          <rect x="250" y="24" width="140" height="72" rx="12" fill="white" stroke="#E9DDC4"/><text x="320" y="54" text-anchor="middle" font-size="11" font-weight="800" fill="#111">Relay</text><text x="320" y="68" text-anchor="middle" font-size="10" fill="#6B6575">FastAPI</text>
          <rect x="484" y="24" width="140" height="72" rx="12" fill="#111" /><text x="554" y="54" text-anchor="middle" font-size="11" font-weight="800" fill="#FFFBF0">Daemon</text><text x="554" y="68" text-anchor="middle" font-size="10" fill="#9A94A6">Python</text>
          <line x1="156" y1="60" x2="250" y2="60" stroke="#111" stroke-width="1.5" stroke-dasharray="6 6"/><line x1="390" y1="60" x2="484" y2="60" stroke="#111" stroke-width="1.5" stroke-dasharray="6 6"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section" style="background:var(--surface-2);border-top:1px solid var(--border)">
    <div class="container">
      <h2 class="reveal">FAQ</h2>
      <div style="margin-top:16px;max-width:760px">
        <details class="faq reveal"><summary>Does my PC need to stay on?<span style="color:var(--faint);font-weight:400">+</span></summary><p>Yes — daemon runs idle in background. <span class="kbd">runmote start</span> / <span class="kbd">runmote status</span>.</p></details>
        <details class="faq reveal" data-delay="40"><summary>Is this secure?<span style="color:var(--faint)">+</span></summary><p>All WSS/TLS. Session data stays on your machine. Self-host relay with one Docker container.</p></details>
        <details class="faq reveal" data-delay="80"><summary>Can anyone connect with the code?<span style="color:var(--faint)">+</span></summary><p>No — fresh 8-digit + QR each start, only visible in your terminal/log. Rotates on restart.</p></details>
        <details class="faq reveal" data-delay="120"><summary>iPhone and Android?<span style="color:var(--faint)">+</span></summary><p>Yes — Flutter native. Play Store + APK. iOS via TestFlight.</p></details>
      </div>
      <div class="card reveal" data-delay="160" style="margin-top:18px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between">
        <div><h3>Ready to try?</h3><p style="margin:4px 0 0;color:var(--muted);font-size:13px">One command. 30 seconds.</p></div>
        <div style="display:flex;gap:10px"><a class="btn btn-primary" href="#install">Install daemon</a><a class="btn btn-ghost" href="https://github.com/Raza-learner/Runmote">GitHub</a></div>
      </div>
    </div>
  </section>

  <footer class="section" style="padding:24px 0;color:var(--faint);font-size:11px">
    <div class="container" style="display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between">
      <span>MIT © Raza — <a href="https://github.com/Raza-learner/Runmote" style="color:var(--muted);text-decoration:underline">Runmote</a> • ACP</span>
      <span><a href="https://ko-fi.com/razalearner" style="color:var(--muted)">Ko-fi</a> • <a href="https://github.com/sponsors/Raza-learner" style="color:var(--muted)">Sponsor</a></span>
    </div>
  </footer>

  <script>
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        const t = (b as HTMLElement).dataset.copy!;
        await navigator.clipboard.writeText(t);
        const o = (b as HTMLElement).textContent;
        (b as HTMLElement).textContent = 'Copied!';
        setTimeout(() => ((b as HTMLElement).textContent = o), 1100);
      });
    });
  </script>
</Layout>

<style>
  @media (max-width: 960px) {
    .container[style*="grid-template-columns:1.05fr"] { grid-template-columns: 1fr !important; }
    .grid[style*="repeat(3,1fr)"] { grid-template-columns: 1fr !important; }
    .container[style*="grid-template-columns:1fr 1.2fr"] { grid-template-columns: 1fr !important; }
  }
</style>
