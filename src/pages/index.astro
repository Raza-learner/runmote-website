---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="#" style="display:flex;align-items:center;gap:10px;font-weight:850;letter-spacing:-0.04em">
        <span style="width:28px;height:28px;border-radius:8px;background:var(--accent);color:white;display:grid;place-items:center;font-size:13px;font-weight:850">◐</span>
        Runmote
        <span style="font-family:JetBrains Mono,monospace;font-weight:700;color:var(--faint);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;border:1px solid var(--border);padding:3px 8px;border-radius:999px;background:var(--surface)">ACP • OSS</span>
      </a>
      <nav class="nav-links">
        <a href="#how">How it works</a>
        <a href="#faq">FAQ</a>
        <a href="https://github.com/Raza-learner/Runmote" target="_blank" rel="noreferrer">GitHub</a>
        <a class="nav-cta" href="#install">Get started</a>
      </nav>
    </div>
  </header>

  <!-- HERO — unique: left line eyebrow + acid underline, NOT happy pill hero -->
  <section class="section" style="padding-top:42px">
    <div class="container" style="display:grid;grid-template-columns:1.05fr 0.95fr;gap:44px;align-items:center">
      <div>
        <div class="eyebrow reveal">Mobile → PC • QR or 8-digit • No SSH</div>
        <h1 class="reveal" data-delay="60" style="margin-top:14px">
          Code from<br/>
          <span style="position:relative;display:inline-block">your phone.<span style="position:absolute;left:0;right:0;bottom:4px;height:10px;background:var(--accent-lime);z-index:-1;opacity:0.9"></span></span>
        </h1>
        <p class="lead reveal" data-delay="110" style="margin-top:12px">
          Run any ACP agent on your PC — <b style="color:var(--text)">opencode, Claude Code, Codex, Cursor</b> — from iOS or Android. One command. Any network.
        </p>

        <div class="reveal" data-delay="150" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:20px">
          <a class="btn btn-primary" href="#install">Install — curl | bash</a>
          <a class="btn btn-ghost" href="https://play.google.com/store/apps/details?id=dev.runmote.app" target="_blank" rel="noreferrer">Google Play</a>
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:JetBrains Mono,monospace;font-size:11px;color:var(--muted)"><span class="signal-dot"></span> WSS • live</span>
        </div>

        <div class="reveal" data-delay="190" style="margin-top:16px">
          <span id="install" class="code-pill"><span style="opacity:.6;color:#9AA0AE">$</span> curl -fsSL https://runmote.dev/install.sh | bash <button data-copy="curl -fsSL https://runmote.dev/install.sh | bash" style="margin-left:4px;background:#1A1A1E;color:#F8F8F6;border:1px solid #2A2A2E;padding:6px 8px;border-radius:8px;cursor:pointer;font-size:11px;font-family:JetBrains Mono,monospace">Copy</button></span>
          <div style="margin-top:8px;color:var(--faint);font-size:11px;font-family:JetBrains Mono,monospace">win: <span class="kbd">irm https://runmote.dev/install.ps1 | iex</span> • self-hostable relay</div>
        </div>

        <div class="reveal" data-delay="230" style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          <span style="font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--faint);font-weight:700">Agents</span>
          <span style="font-size:12px;font-weight:700;border:1px solid var(--border);padding:4px 8px;border-radius:999px;background:white">opencode</span>
          <span style="font-size:12px;font-weight:700;border:1px solid var(--border);padding:4px 8px;border-radius:999px;background:white">claude</span>
          <span style="font-size:12px;font-weight:700;border:1px solid var(--border);padding:4px 8px;border-radius:999px;background:white">codex</span>
          <span style="font-size:12px;font-weight:700;border:1px solid var(--border);padding:4px 8px;border-radius:999px;background:white">cursor</span>
          <span style="font-size:12px;font-weight:700;border:1px solid var(--border);padding:4px 8px;border-radius:999px;background:white">copilot</span>
        </div>
      </div>

      <div class="reveal" data-delay="130" style="display:grid;place-items:center">
        <div class="phone">
          <div class="phone-screen">
            <div class="phone-notch"></div>
            <div style="padding:12px 12px 0;display:flex;align-items:center;justify-content:space-between">
              <span style="font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#9AA0AE;font-weight:700">Runmote</span>
              <span class="signal-dot" style="width:7px;height:7px"></span>
            </div>
            <div style="margin:12px 12px 0;padding:12px;border-radius:12px;border:1.5px solid var(--accent-lime);background:var(--accent-lime)">
              <div style="font-family:JetBrains Mono,monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:#0A0A0B;font-weight:800">Pairing code — QR or 8-digit</div>
              <div style="font-family:JetBrains Mono,monospace;font-size:20px;letter-spacing:0.14em;font-weight:850;margin-top:4px;color:#0A0A0B">84 92 17 05</div>
              <div style="font-size:11px;color:#0A0A0B;opacity:0.7;margin-top:2px">rotates on restart • no SSH</div>
            </div>
            <div style="margin:10px 12px;display:grid;gap:7px">
              <div style="display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;background:white;border:1px solid #E6E6E0"><span style="width:26px;height:26px;border-radius:7px;background:#0A0A0B;display:grid;place-items:center;color:var(--accent-lime);font-size:11px">›</span><div><div style="font-weight:800;font-size:12px">opencode</div><div style="font-family:JetBrains Mono,monospace;font-size:10px;color:#6B7280">acp • auto-detected</div></div><span style="margin-left:auto;width:7px;height:7px;border-radius:999px;background:#16A34A"></span></div>
              <div style="display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;background:white;border:1px solid #E6E6E0"><span style="width:26px;height:26px;border-radius:7px;background:white;border:1px solid #E6E6E0;display:grid;place-items:center;font-size:11px">✦</span><div><div style="font-weight:800;font-size:12px">claude</div><div style="font-family:JetBrains Mono,monospace;font-size:10px;color:#6B7280">claude-agent-acp</div></div><span style="margin-left:auto;width:7px;height:7px;border-radius:999px;background:#16A34A"></span></div>
              <div style="display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;background:white;border:1px solid #E6E6E0"><span style="width:26px;height:26px;border-radius:7px;background:white;border:1px solid #E6E6E0;display:grid;place-items:center;font-size:11px">⬡</span><div><div style="font-weight:800;font-size:12px">codex</div><div style="font-family:JetBrains Mono,monospace;font-size:10px;color:#6B7280">codex-acp</div></div><span style="margin-left:auto;width:7px;height:7px;border-radius:999px;background:#6D28FF"></span></div>
            </div>
            <div style="margin-top:auto;padding:10px 12px;display:flex;gap:8px">
              <span style="flex:1;padding:11px;border-radius:10px;background:var(--accent);color:white;text-align:center;font-weight:800;font-size:12px">Connect</span>
              <span style="padding:11px 12px;border-radius:10px;background:white;border:1px solid #E6E6E0;font-weight:800;font-size:12px">Scan QR</span>
            </div>
          </div>
        </div>
        <div style="margin-top:10px;font-family:JetBrains Mono,monospace;font-size:10px;color:var(--faint);display:flex;gap:8px;align-items:center"><span style="width:16px;height:1.5px;background:var(--accent-lime)"></span> encrypted WSS • session on your machine</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- WHY — 3 cards with left accent, NOT happy warm blocks -->
  <section class="section">
    <div class="container">
      <div class="eyebrow reveal">Why Runmote</div>
      <h2 class="reveal" data-delay="60" style="margin-top:10px">SSH is powerful. It’s also work.</h2>
      <div class="grid reveal" data-delay="110" style="grid-template-columns:repeat(3,1fr);margin-top:18px">
        <div class="card card-accent"><div style="width:28px;height:28px;border-radius:7px;background:var(--text);color:var(--accent-lime);display:grid;place-items:center;font-size:12px">◷</div><h3 style="margin-top:10px">30 min → 30 sec</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">No firewall, no port forwarding. One curl command.</p></div>
        <div class="card card-violet"><div style="width:28px;height:28px;border-radius:7px;background:var(--accent);color:white;display:grid;place-items:center;font-size:12px">◎</div><h3 style="margin-top:10px">Any network</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Home, office, 4G, hotel WiFi — WSS only.</p></div>
        <div class="card" style="border-left:3px solid #0A0A0B"><div style="width:28px;height:28px;border-radius:7px;background:var(--accent-lime);color:var(--text);display:grid;place-items:center;font-size:12px">↻</div><h3 style="margin-top:10px">Sessions resume</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Kill the app, phone dies — right where you left off.</p></div>
      </div>
    </div>
  </section>

  <!-- HOW — lime tint block, distinct from happy green #dbe2cd -->
  <section id="how" class="section" style="background: linear-gradient(180deg, rgba(214,255,42,0.08), rgba(214,255,42,0.02));border-block:1px solid var(--border)">
    <div class="container">
      <h2 class="reveal">Three steps. Two minutes.</h2>
      <div class="grid reveal" data-delay="80" style="grid-template-columns:repeat(3,1fr);margin-top:18px">
        <div class="card"><span style="font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--faint);font-weight:700">01 — Install</span><h3 style="margin-top:8px">Daemon on your PC</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 10px">Linux / macOS / Windows. Auto-detects agents.</p><div style="font-family:JetBrains Mono,monospace;font-size:11px;background:#0A0A0B;color:#F8F8F6;padding:10px 12px;border-radius:8px;border-left:3px solid var(--accent-lime)">curl -fsSL https://runmote.dev/install.sh | bash</div></div>
        <div class="card"><span style="font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--faint);font-weight:700">02 — Pair</span><h3 style="margin-top:8px">QR or 8-digit</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Scan or type code from <span class="kbd">runmote code</span>. Fresh each restart.</p></div>
        <div class="card"><span style="font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--faint);font-weight:700">03 — Code</span><h3 style="margin-top:8px">Anywhere</h3><p style="color:var(--muted);font-size:13px;margin:6px 0 0">Streaming tool calls, diffs, approvals — same ACP session.</p></div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:baseline;justify-content:space-between">
        <h2 class="reveal">Everything you need. Nothing you don’t.</h2>
        <span class="reveal" data-delay="60" style="font-family:JetBrains Mono,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--faint);border:1px solid var(--border);padding:4px 8px;border-radius:999px;background:var(--surface)">ACP-native • MIT</span>
      </div>
      <div class="grid reveal" data-delay="100" style="grid-template-columns:repeat(3,1fr);margin-top:18px">
        <div class="card card-accent"><h3>Streaming</h3><p style="color:var(--muted);font-size:13px">Live agent output, tool calls, diffs — no polling.</p></div>
        <div class="card card-violet"><h3>Self-hostable relay</h3><p style="color:var(--muted);font-size:13px"><span class="kbd">docker compose up -d</span> → <span class="kbd">ACP_RELAY_URL</span>.</p></div>
        <div class="card" style="border-left:3px solid #0A0A0B"><h3>Native apps</h3><p style="color:var(--muted);font-size:13px">Flutter iOS/Android. Daemon Linux/macOS/Windows.</p></div>
      </div>
    </div>
  </section>

  <!-- STATS — unique: ink bar + lime accent + mono, vs happy no stats -->
  <section id="stats" class="section" style="padding-top:0">
    <div class="container">
      <div class="card" style="display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between;background:#0A0A0B;color:#F8F8F6;border-color:#1A1A1E">
        <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center">
          <div><div id="stat-stars" class="stat-num" data-value="0" style="color:var(--accent-lime)">0</div><div class="stat-label" style="color:#9AA0AE">GitHub stars — live</div></div>
          <div style="width:1px;height:36px;background:#222"></div>
          <div><div id="stat-forks" class="stat-num" data-value="0" style="color:white">0</div><div class="stat-label" style="color:#9AA0AE">Forks</div></div>
          <div style="width:1px;height:36px;background:#222"></div>
          <div><div id="stat-releases" class="stat-num" data-value="0" style="color:white">0</div><div class="stat-label" style="color:#9AA0AE">Releases</div></div>
          <div style="width:1px;height:36px;background:#222"></div>
          <div><div style="font-family:JetBrains Mono,monospace;font-size:22px;font-weight:800;letter-spacing:-0.04em;color:white">WSS</div><div class="stat-label" style="color:#9AA0AE">Encrypted</div></div>
        </div>
        <a href="https://github.com/Raza-learner/Runmote" target="_blank" rel="noreferrer" class="btn btn-lime" style="padding:10px 14px">Star on GitHub →</a>
      </div>
      <div style="margin-top:8px;color:var(--faint);font-family:JetBrains Mono,monospace;font-size:10px">CountUp.js + anime.js • live from <span class="kbd">api.github.com</span></div>
    </div>
  </section>

  <!-- ARCH — thin lines, mono labels -->
  <section class="section" style="padding-top:0">
    <div class="container" style="display:grid;grid-template-columns:1fr 1.2fr;gap:24px;align-items:center">
      <div class="reveal">
        <div class="eyebrow">Architecture</div>
        <h2 style="margin-top:8px">No hacks. Just WSS.</h2>
        <p style="color:var(--muted);margin-top:8px;font-size:13px">Phone → Relay → Daemon → ACP agent via stdin/stdout. Session lives on your machine, not the relay.</p>
        <div style="margin-top:12px;display:flex;gap:6px;flex-wrap:wrap"><span class="kbd">WSS/TLS</span><span class="kbd">JSON-RPC 2.0</span><span class="kbd">SQLite</span></div>
      </div>
      <div class="card reveal" data-delay="80" style="padding:0;overflow:hidden;background:white">
        <svg viewBox="0 0 640 120" width="100%" height="auto" style="display:block">
          <rect x="16" y="24" width="140" height="72" rx="10" fill="white" stroke="#E6E6E0"/><text x="86" y="54" text-anchor="middle" font-size="11" font-weight="800" fill="#0A0A0B">App</text><text x="86" y="68" text-anchor="middle" font-size="9" font-family="JetBrains Mono,monospace" fill="#6B7280">Flutter</text>
          <rect x="250" y="24" width="140" height="72" rx="10" fill="#0A0A0B" /><text x="320" y="54" text-anchor="middle" font-size="11" font-weight="800" fill="white">Relay</text><text x="320" y="68" text-anchor="middle" font-size="9" font-family="JetBrains Mono,monospace" fill="#9AA0AE">FastAPI • WSS</text>
          <rect x="484" y="24" width="140" height="72" rx="10" fill="white" stroke="var(--accent-lime)" stroke-width="1.5"/><text x="554" y="54" text-anchor="middle" font-size="11" font-weight="800" fill="#0A0A0B">Daemon</text><text x="554" y="68" text-anchor="middle" font-size="9" font-family="JetBrains Mono,monospace" fill="#6B7280">Python</text>
          <line x1="156" y1="60" x2="250" y2="60" stroke="#0A0A0B" stroke-width="1.2" stroke-dasharray="6 6"/><line x1="390" y1="60" x2="484" y2="60" stroke="#0A0A0B" stroke-width="1.2" stroke-dasharray="6 6"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section" style="background:var(--surface-2);border-top:1px solid var(--border)">
    <div class="container">
      <h2 class="reveal">FAQ</h2>
      <div style="margin-top:16px;max-width:760px">
        <details class="faq reveal"><summary>Does my PC need to stay on?<span style="color:var(--faint)">+</span></summary><p>Yes — daemon idles in background. <span class="kbd">runmote start</span> / <span class="kbd">status</span>.</p></details>
        <details class="faq reveal" data-delay="40"><summary>Is this secure?<span style="color:var(--faint)">+</span></summary><p>All WSS/TLS. Data stays on your machine. Self-host relay with Docker.</p></details>
        <details class="faq reveal" data-delay="80"><summary>Can anyone connect?<span style="color:var(--faint)">+</span></summary><p>No — fresh 8-digit + QR each start, only in your terminal. Rotates on restart.</p></details>
        <details class="faq reveal" data-delay="120"><summary>iPhone and Android?<span style="color:var(--faint)">+</span></summary><p>Yes — Flutter native. Play Store + APK. iOS TestFlight.</p></details>
      </div>
      <div class="card reveal" data-delay="150" style="margin-top:18px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;border-left:3px solid var(--accent)">
        <div><h3>Ready to try?</h3><p style="margin:4px 0 0;color:var(--muted);font-size:13px">One command. 30 seconds.</p></div>
        <div style="display:flex;gap:10px"><a class="btn btn-primary" href="#install">Install daemon</a><a class="btn btn-ghost" href="https://github.com/Raza-learner/Runmote">GitHub</a></div>
      </div>
    </div>
  </section>

  <footer class="section" style="padding:22px 0;color:var(--faint);font-size:11px;font-family:JetBrains Mono,monospace">
    <div class="container" style="display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between">
      <span>MIT © Raza — <a href="https://github.com/Raza-learner/Runmote" style="color:var(--muted);text-decoration:underline">Runmote</a> • ACP</span>
      <span><a href="https://ko-fi.com/razalearner" style="color:var(--muted)">Ko-fi</a> • <a href="https://github.com/sponsors/Raza-learner" style="color:var(--muted)">Sponsor</a></span>
    </div>
  </footer>

  <script>
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        const t = (b as HTMLElement).dataset.copy!;
        await navigator.clipboard.writeText(t);
        const o = (b as HTMLElement).textContent;
        (b as HTMLElement).textContent = 'Copied!';
        setTimeout(() => ((b as HTMLElement).textContent = o), 1100);
      });
    });
  </script>
</Layout>

<style>
  @media (max-width: 960px) {
    .container[style*="grid-template-columns:1.05fr"] { grid-template-columns: 1fr !important; }
    .grid[style*="repeat(3,1fr)"] { grid-template-columns: 1fr !important; }
    .container[style*="grid-template-columns:1fr 1.2fr"] { grid-template-columns: 1fr !important; }
  }
</style>
