---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Runmote — Run any ACP agent from your phone', description = 'Run any AI coding agent on your PC from your phone via QR code or 8-digit pairing. No SSH. No VPN. Works on iOS, Android, Linux, macOS, Windows.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://runmote.dev" />
    <meta name="theme-color" content="#F7F4EE" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:image" content="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
    <script>
      import { initScroll } from '../scripts/lenis.ts';
      import { initReveals, initPipeline } from '../scripts/anime-scroll.ts';
      import { initStats } from '../scripts/stats.ts';
      initScroll();
      initReveals();
      initPipeline();
      initStats();
    </script>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
